{
  "name": "@sitevitals/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Always-on service: scheduled checks, result persistence, alerting, monthly reports.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/worker.ts",
    "start": "node dist/worker.js",
    "test": "vitest run",
    "seed": "tsx src/seed.ts",
    "trigger": "tsx src/trigger.ts",
    "gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/db/database.types.ts"
  },
  "dependencies": {
    "@sentry/node": "^8.55.0",
    "@sitevitals/engine": "workspace:*",
    "@supabase/supabase-js": "^2.49.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.10.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
