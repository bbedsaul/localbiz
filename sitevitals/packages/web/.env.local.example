# Supabase — same project as the worker. The anon key is safe in the browser;
# RLS enforces per-owner access. The service-role key is server-only (Stripe webhook).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used for Stripe redirect/return URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — optional in dev. Without these, onboarding skips checkout and goes
# straight to the dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
