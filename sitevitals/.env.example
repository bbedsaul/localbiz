# All keys are optional — checks needing a missing key report status "skipped".

# Performance + security checks. GOOGLE_API_KEY is a fallback for both, and
# for the Places listing lookup.
PAGESPEED_API_KEY=
SAFE_BROWSING_API_KEY=
GOOGLE_API_KEY=

# Local search visibility (C4). SERP_PROVIDER: dataforseo (default) | serpapi.
SERP_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=

# Listing consistency (C5).
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=
FACEBOOK_ACCESS_TOKEN=

# Report narration (falls back to a non-AI template when unset).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Report delivery via Resend.
RESEND_API_KEY=
REPORT_FROM_EMAIL="SiteVitals <reports@yourdomain.com>"
